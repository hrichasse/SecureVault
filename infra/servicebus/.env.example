# Variables del emulador de Service Bus. Copiar a .env (ignorado por git).

# 'Y' acepta los términos de licencia del emulador de Service Bus y de SQL Server Linux:
#   https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
#   https://go.microsoft.com/fwlink/?LinkId=746388
ACCEPT_EULA="N"

# Contraseña del SQL Server local que usa el emulador (mínimo 8 caracteres,
# con mayúsculas, minúsculas, números y símbolos).
MSSQL_SA_PASSWORD=""
