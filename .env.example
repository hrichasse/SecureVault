# ============================================================
# SecureVault AI — Environment Variables Template
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local a git.
# ============================================================

# ----- Database (Supabase PostgreSQL) -----
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Auth / JWT -----
JWT_SECRET=

# ----- Application -----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Vault Assistant (Gemini AI — Tier Gratuito) -----
# Obtener gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ----- Mensajería (Azure Service Bus) -----
# Opcional. Sin esta variable los eventos se procesan en línea, sin cola ni reintentos.
# Emulador local (npm run mq:up):
#   Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
# Azure: namespace de nivel Standard o superior; basta una clave con permisos Send y Listen.
# Puesta en marcha: docs/mensajeria.md
SERVICEBUS_CONNECTION_STRING=""
# Prefijo de las entidades. Úsalo si dos entornos comparten el mismo namespace.
SERVICEBUS_ENTITY_PREFIX=""
